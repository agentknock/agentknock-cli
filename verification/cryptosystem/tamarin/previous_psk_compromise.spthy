/* R05: active-network candidate gate with previous-only disclosure.
 * Independent fresh generations isolate the local gate; the binding_state
 * theory separately proves generation replacement. The current-key reveal is
 * a sensitivity control. No private authenticated wire assumes the conclusion.
 */
theory Agentknock_Previous_PSK_Compromise
begin
builtins: asymmetric-encryption, symmetric-encryption
functions: hpke_info/3, psk_context/4, exporter/2, record_key/2

rule EstablishOverlap:
  [ Fr(~skD), Fr(~did), Fr(~cid), Fr(~current), Fr(~old) ]
  --[ OverlapCreated(~cid, ~did, ~current, ~old) ]->
  [ !Overlap(~cid, ~did, ~skD, ~current, ~old),
    Out(<~cid, ~did, pk(~skD), ~old>) ]

rule RevealCurrentForControl:
  [ !Overlap(cid, did, skD, current, old) ]
  --[ CurrentRevealed(cid, did, current) ]->
  [ Out(current) ]

rule HonestCurrentHolderSends:
  let renc = aenc(~rs, pk(skD))
      candidate = exporter(psk_context(~rs, current, cid,
                          hpke_info('agentknock-v1', did, 'zero_request_id')),
                          'agentknock-v1 psk')
      ctx = psk_context(~seed, candidate, cid,
                        hpke_info('agentknock-v1', did, ~rid))
      enc = aenc(~seed, pk(skD))
      ct = senc(~plain, record_key(ctx, 'record_0'))
  in
  [ !Overlap(cid, did, skD, current, old), Fr(~rs), Fr(~seed), Fr(~rid), Fr(~plain) ]
  --[ HonestCandidateSent(cid, did, ~rid, renc, enc, ct) ]->
  [ Out(<cid, did, ~rid, renc, enc, ct>) ]

rule DeviceChecksCandidate:
  let renc = aenc(rs, pk(skD))
      candidate = exporter(psk_context(rs, current, cid,
                          hpke_info('agentknock-v1', did, 'zero_request_id')),
                          'agentknock-v1 psk')
      ctx = psk_context(seed, candidate, cid,
                        hpke_info('agentknock-v1', did, rid))
      enc = aenc(seed, pk(skD))
      ct = senc(plain, record_key(ctx, 'record_0'))
  in
  [ !Overlap(cid, did, skD, current, old), In(<cid, did, rid, renc, enc, ct>) ]
  --[ CandidateAccepted(cid, did, current, rid, renc, enc, ct) ]->
  [ ]

lemma R05_compromised_previous_psk_cannot_forge_rotation:
  "All cid did current rid renc enc ct #i.
       CandidateAccepted(cid, did, current, rid, renc, enc, ct)@i
     ==> (Ex #j. HonestCandidateSent(cid, did, rid, renc, enc, ct)@j & #j < #i)
       | (Ex #r. CurrentRevealed(cid, did, current)@r & #r < #i)"

lemma R05_honest_candidate_gate_executable:
  exists-trace
  "Ex cid did current rid renc enc ct #i.
       CandidateAccepted(cid, did, current, rid, renc, enc, ct)@i
     & not (Ex c d p #r. CurrentRevealed(c, d, p)@r)"

lemma C01_current_disclosure_allows_candidate_forgery:
  exists-trace
  "Ex cid did current rid renc enc ct #i.
       CandidateAccepted(cid, did, current, rid, renc, enc, ct)@i
     & not (Ex #j. HonestCandidateSent(cid, did, rid, renc, enc, ct)@j)"
end
