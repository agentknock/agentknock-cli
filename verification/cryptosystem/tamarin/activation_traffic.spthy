/*
 * Agentknock v1: focused post-SAS activation traffic secrecy.
 *
 * A fresh pending binding represents the output of a successful equal-SAS
 * transition, whose state/authentication properties are proved in
 * pairing_activation.spthy.  This theory isolates the exact PSK-mode
 * request, response, and completion schedules so their secrecy proofs do not
 * inherit unrelated base-pairing/replay source chains.  PSK-only disclosure
 * is explicit and is intentionally not a secrecy exception; stable device-key
 * disclosure is.
 */

theory Agentknock_Activation_Traffic
begin

builtins: asymmetric-encryption, symmetric-encryption

functions:
  hpke_info/3,
  psk_context/4,
  record_key/2,
  exporter/2,
  response_kdf/4

rule EstablishPendingBinding:
  [ Fr(~skD), Fr(~device_id), Fr(~client_id), Fr(~psk) ]
  -->
  [ !DeviceIdentity(~device_id, ~skD),
    !PendingPSKCopy(~client_id, ~device_id, ~psk),
    ClientPendingActivation(~client_id, ~device_id, pk(~skD), ~psk),
    DevicePendingActivation(~client_id, ~device_id, ~skD, ~psk),
    Out(< 'pending_binding_public', ~client_id,
          ~device_id, pk(~skD) >) ]

rule RevealDeviceKey:
  [ !DeviceIdentity(device_id, skD) ]
  --[ DeviceKeyRevealed(device_id) ]->
  [ Out(skD) ]

rule RevealPendingPSK:
  [ !PendingPSKCopy(client_id, device_id, psk) ]
  --[ PendingPSKRevealed(client_id, device_id, psk) ]->
  [ Out(psk) ]

rule ClientSendsActivationRequest:
  let info = hpke_info('agentknock-v1', device_id, ~request_id)
      ctx = psk_context(~kem_seed, psk, client_id, info)
      enc = aenc(~kem_seed, pkD)
      c0 = senc(~request, record_key(ctx, 'record_0'))
  in
  [ ClientPendingActivation(client_id, device_id, pkD, psk),
    Fr(~request_id), Fr(~kem_seed), Fr(~request) ]
  --[ ActivationRequestSecret(client_id, device_id,
                              ~request_id, ~request),
      HonestActivationContext(client_id, device_id, ~request_id,
                              enc, ctx, psk) ]->
  [ ClientWaitResponse(client_id, device_id, ~request_id, enc, ctx),
    ClientCompletionReady(client_id, device_id, ~request_id, ctx),
    Out(< 'paired_request', client_id, ~request_id,
          'agentknock-v1', enc, c0, 'no_rotation' >) ]

rule DeviceAcceptsActivationRequest:
  let info = hpke_info('agentknock-v1', device_id, request_id)
      ctx = psk_context(kem_seed, psk, client_id, info)
      enc = aenc(kem_seed, pk(skD))
      c0 = senc(request, record_key(ctx, 'record_0'))
      secret = exporter(ctx, 'agentknock-v1 response')
      key = response_kdf(secret, enc, ~response_random, 'key')
      nonce = response_kdf(secret, enc, ~response_random, 'nonce')
      response_ct = senc(~response, <key, nonce>)
  in
  [ DevicePendingActivation(client_id, device_id, skD, psk),
    In(< 'paired_request', client_id, request_id,
         'agentknock-v1', enc, c0, rotation_field >),
    Fr(~response_random), Fr(~response) ]
  --[ DeviceActivationRequestAccepted(client_id, device_id, request_id),
      ActivationResponseSecret(client_id, device_id, request_id,
                               enc, ctx, psk, ~response) ]->
  [ DeviceWaitCompletion(client_id, device_id, request_id, ctx),
    Out(< 'paired_response', client_id, request_id,
          ~response_random, response_ct >) ]

rule ClientAcceptsActivationResponse:
  let secret = exporter(ctx, 'agentknock-v1 response')
      key = response_kdf(secret, enc, response_random, 'key')
      nonce = response_kdf(secret, enc, response_random, 'nonce')
  in
  [ ClientWaitResponse(client_id, device_id, request_id, enc, ctx),
    In(< 'paired_response', client_id, request_id, response_random,
         senc(response, <key, nonce>) >) ]
  --[ ClientActivationResponseAccepted(client_id, device_id,
                                       request_id, response) ]->
  [ ]

rule ClientSendsActivationCompletion:
  let c1 = senc(~completion, record_key(ctx, 'record_1'))
  in
  [ ClientCompletionReady(client_id, device_id, request_id, ctx),
    Fr(~completion) ]
  --[ ActivationCompletionSecret(client_id, device_id,
                                 request_id, ~completion) ]->
  [ Out(< 'paired_completion', client_id, request_id, c1 >) ]

rule DeviceAcceptsActivationCompletion:
  [ DeviceWaitCompletion(client_id, device_id, request_id, ctx),
    In(< 'paired_completion', client_id, request_id,
         senc(completion, record_key(ctx, 'record_1')) >) ]
  --[ DeviceActivationCompletionAccepted(client_id, device_id,
                                         request_id, completion) ]->
  [ ]

restriction UniqueActivationRequest:
  "All client_id device_id request_id #i #j.
       DeviceActivationRequestAccepted(client_id, device_id, request_id)@i
     & DeviceActivationRequestAccepted(client_id, device_id, request_id)@j
     ==> #i = #j"

lemma activation_request_confidentiality:
  "All client_id device_id request_id request #i #j.
       ActivationRequestSecret(client_id, device_id, request_id, request)@i
     & K(request)@j
     ==> (Ex #r. DeviceKeyRevealed(device_id)@r)"

lemma activation_response_confidentiality:
  "All client_id device_id request_id enc ctx psk response #s #i #j.
       HonestActivationContext(client_id, device_id, request_id,
                               enc, ctx, psk)@s
     & ActivationResponseSecret(client_id, device_id, request_id,
                                enc, ctx, psk, response)@i
     & K(response)@j
     ==> (Ex #r. DeviceKeyRevealed(device_id)@r)"

lemma C01_compromised_psk_exposes_attacker_initiated_activation_response:
  exists-trace
  "Ex client_id device_id request_id enc ctx psk response #r #i #k.
       PendingPSKRevealed(client_id, device_id, psk)@r
     & ActivationResponseSecret(client_id, device_id, request_id,
                                enc, ctx, psk, response)@i
     & K(response)@k
     & #r < #i & #i < #k
     & not (Ex #s.
              HonestActivationContext(client_id, device_id, request_id,
                                      enc, ctx, psk)@s)
     & not (Ex #d. DeviceKeyRevealed(device_id)@d)"

lemma activation_completion_confidentiality:
  "All client_id device_id request_id completion #i #j.
       ActivationCompletionSecret(client_id, device_id,
                                  request_id, completion)@i
     & K(completion)@j
     ==> (Ex #r. DeviceKeyRevealed(device_id)@r)"

end
