/* R09: arbitrary-sequence isolation of a map keyed by (client_id, device_id).
 * An attacker may request arbitrary updates to an entry. The state is opaque:
 * it can stand for current/previous PSKs, pending flags, status, or deadlines.
 * Cryptographic gates and legal lifecycle transitions are checked separately.
 * Observations read the actual linear state at different times; no event
 * asserts that another entry is unchanged by definition.
 */
theory Agentknock_Binding_Isolation
begin

rule RegisterDevice:
  [ Fr(~did) ] --> [ !Device(~did), Out(~did) ]

rule CreateBinding:
  [ !Device(did), Fr(~cid), Fr(~initial) ]
  --[ BindingCreated(~cid, did, ~initial) ]->
  [ Binding(~cid, did, ~initial), Out(~cid) ]

rule UpdateOneBinding:
  [ Binding(cid, did, before), In(after) ]
  --[ BindingMutation(cid, did) ]->
  [ Binding(cid, did, after) ]

rule ObserveBinding:
  [ Binding(cid, did, state) ]
  --[ BindingObserved(cid, did, state) ]->
  [ Binding(cid, did, state) ]

lemma R09_other_binding_stable_without_its_own_mutation [use_induction]:
  "All cid did before after #i #j.
       BindingObserved(cid, did, before)@i & BindingObserved(cid, did, after)@j
     & #i < #j
     & not (Ex #m. BindingMutation(cid, did)@m & #i < #m & #m < #j)
     ==> before = after"

lemma R09_two_bindings_isolation_executable:
  exists-trace
  "Ex cid1 cid2 did state #i #j #k.
       BindingObserved(cid1, did, state)@i & BindingMutation(cid2, did)@j
     & BindingObserved(cid1, did, state)@k
     & not (cid1 = cid2) & #i < #j & #j < #k"
end
