/*
 * Agentknock v1: two adjacent device rotations replace the older overlap.
 *
 * The two phase-indexed transitions are a generic local window of an
 * arbitrary lineage.  Candidate authentication itself is proved by R02 in
 * psk_rotation.spthy.
 */

theory Agentknock_Previous_PSK_Replacement
begin

rule EstablishActiveBinding:
  [ Fr(~client_id), Fr(~device_id), Fr(~psk0) ]
  -->
  [ Generation0(~client_id, ~device_id, ~psk0) ]

rule AdoptFirstSuccessor:
  [ Generation0(client_id, device_id, psk0),
    Fr(~psk1), Fr(~rid1), Fr(~enc1), Fr(~rctx1), Fr(~ctx1) ]
  --[ DeviceCandidateAdopted(client_id, device_id, ~rid1,
                            psk0, ~psk1, ~enc1, ~rctx1, ~ctx1,
                            <'none', 'none'>) ]->
  [ Generation1(client_id, device_id, psk0, ~psk1) ]

rule AcceptOlderDuringFirstOverlap:
  [ Generation1(client_id, device_id, psk0, psk1),
    Fr(~request_id) ]
  --[ DevicePreviousRequestAccepted(client_id, device_id, ~request_id,
                                    psk1, psk0,
                                    'no_rotation', 'state_ctx') ]->
  [ Generation1(client_id, device_id, psk0, psk1) ]

rule AdoptSecondSuccessor:
  [ Generation1(client_id, device_id, psk0, psk1),
    Fr(~psk2), Fr(~rid2), Fr(~enc2), Fr(~rctx2), Fr(~ctx2) ]
  --[ DeviceCandidateAdopted(client_id, device_id, ~rid2,
                            psk1, ~psk2, ~enc2, ~rctx2, ~ctx2,
                            <'previous', psk0>) ]->
  [ Generation2(client_id, device_id, psk1, ~psk2) ]

rule AcceptPreviousDuringSecondOverlap:
  [ Generation2(client_id, device_id, psk1, psk2),
    Fr(~request_id) ]
  --[ DevicePreviousRequestAccepted(client_id, device_id, ~request_id,
                                    psk2, psk1,
                                    'no_rotation', 'state_ctx') ]->
  [ Generation2(client_id, device_id, psk1, psk2) ]

lemma R05_second_rotation_retires_older_generation [use_induction]:
  "All client_id device_id rid1 p0 p1 enc1 rctx1 ctx1 prev0
       rid2 p2 enc2 rctx2 ctx2 prev1 rid3 rotation ctx3 #i #j #k.
       DeviceCandidateAdopted(client_id, device_id, rid1,
                             p0, p1, enc1, rctx1, ctx1, prev0)@i
     & DeviceCandidateAdopted(client_id, device_id, rid2,
                             p1, p2, enc2, rctx2, ctx2, prev1)@j
     & DevicePreviousRequestAccepted(client_id, device_id, rid3,
                                     p2, p0, rotation, ctx3)@k
     & #i < #j
     ==> #k < #j"

end
