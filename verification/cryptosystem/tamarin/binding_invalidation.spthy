/* Agentknock v1: invalidation consumes authority for new requests (R09). */

theory Agentknock_Binding_Invalidation
begin

rule EstablishActiveBinding:
  [ Fr(~client_id), Fr(~device_id), Fr(~current_psk),
    Fr(~previous_state) ]
  -->
  [ ActiveBinding(~client_id, ~device_id,
                  ~current_psk, ~previous_state) ]

rule AcceptRequest:
  [ ActiveBinding(client_id, device_id, current_psk, previous_state),
    Fr(~request_id) ]
  --[ DeviceRequestAccepted(client_id, device_id, ~request_id,
                            current_psk, 'current', 'no_rotation',
                            'state_enc', 'state_c0', 'state_ctx',
                            'state_request') ]->
  [ ActiveBinding(client_id, device_id, current_psk, previous_state) ]

rule InvalidateBinding:
  [ ActiveBinding(client_id, device_id, current_psk, previous_state) ]
  --[ BindingInvalidated(client_id, device_id,
                        current_psk, previous_state) ]->
  [ !InvalidatedBinding(client_id, device_id) ]

lemma R09_no_new_request_acceptance_after_invalidation [use_induction]:
  "All client_id device_id current prev #i
       rid psk class rotation enc c0 ctx request #j.
       BindingInvalidated(client_id, device_id, current, prev)@i
     & DeviceRequestAccepted(client_id, device_id, rid,
                             psk, class, rotation,
                             enc, c0, ctx, request)@j
     ==> #j < #i"

end
