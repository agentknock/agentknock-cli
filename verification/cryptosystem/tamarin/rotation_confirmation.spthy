/*
 * Agentknock v1: rotation adoption, response confirmation, and recovery.
 *
 * This compositional state theory isolates R00/R06/R07.  Internal request and
 * checked-response wire facts stand for the context-authenticated hops proved
 * against the active attacker by R02 in psk_rotation.spthy and independently
 * by the ProVerif rotation model.  Exact cryptographic terms remain present so
 * the state handoff must still unify with the specified schedules.  Overlap,
 * expiry, invalidation, and completion retention are orthogonal subsystems.
 */

theory Agentknock_Rotation_Confirmation
begin

builtins: asymmetric-encryption, symmetric-encryption

functions:
  hpke_info/3,
  psk_context/4,
  record_key/2,
  exporter/2,
  response_kdf/4

rule EstablishActiveBinding:
  [ Fr(~skD), Fr(~device_id), Fr(~client_id), Fr(~psk0) ]
  -->
  [ ClientBinding(~client_id, ~device_id, pk(~skD),
                  ~psk0, 'none', 'none'),
    DeviceBinding(~client_id, ~device_id, ~skD, ~psk0),
    Out(< 'binding_public', ~client_id, ~device_id, pk(~skD) >) ]

rule ClientStartsRotation:
  let rctx = psk_context(~rotation_seed, old_psk, client_id,
                         hpke_info('agentknock-v1', device_id,
                                   'zero_request_id'))
      renc = aenc(~rotation_seed, pkD)
      new_psk = exporter(rctx, 'agentknock-v1 psk')
  in
  [ ClientBinding(client_id, device_id, pkD,
                  old_psk, 'none', 'none'),
    Fr(~rotation_seed) ]
  --[ ClientRotationStarted(client_id, device_id, old_psk,
                            new_psk, renc, rctx) ]->
  [ ClientBinding(client_id, device_id, pkD,
                  new_psk, 'pending', renc),
    !ClientRotationRecord(client_id, device_id,
                          old_psk, new_psk, renc, rctx) ]

rule ClientSendsPendingRequest:
  let ctx = psk_context(~request_seed, new_psk, client_id,
                        hpke_info('agentknock-v1', device_id,
                                  ~request_id))
      enc = aenc(~request_seed, pkD)
      c0 = senc(~request, record_key(ctx, 'record_0'))
  in
  [ ClientBinding(client_id, device_id, pkD,
                  new_psk, 'pending', renc),
    !ClientRotationRecord(client_id, device_id,
                          old_psk, new_psk, renc, rctx),
    Fr(~request_id), Fr(~request_seed), Fr(~request) ]
  --[ ClientPendingRequestSent(client_id, device_id, ~request_id,
                              new_psk, renc, enc, c0, ctx, ~request) ]->
  [ ClientBinding(client_id, device_id, pkD,
                  new_psk, 'pending', renc),
    ClientWaitResponse(client_id, device_id, ~request_id,
                       new_psk, renc, enc, ctx),
    PendingRequestWire(client_id, device_id, ~request_id,
                       enc, c0, renc) ]

rule DeviceAuthenticatesAndAdoptsCandidate:
  let rctx = psk_context(rotation_seed, old_psk, client_id,
                         hpke_info('agentknock-v1', device_id,
                                   'zero_request_id'))
      renc = aenc(rotation_seed, pk(skD))
      new_psk = exporter(rctx, 'agentknock-v1 psk')
      ctx = psk_context(request_seed, new_psk, client_id,
                        hpke_info('agentknock-v1', device_id, request_id))
      enc = aenc(request_seed, pk(skD))
      c0 = senc(request, record_key(ctx, 'record_0'))
      secret = exporter(ctx, 'agentknock-v1 response')
      key = response_kdf(secret, enc, ~response_random, 'key')
      nonce = response_kdf(secret, enc, ~response_random, 'nonce')
      response_ct = senc(~response, <key, nonce>)
  in
  [ DeviceBinding(client_id, device_id, skD, old_psk),
    PendingRequestWire(client_id, device_id, request_id,
                       enc, c0, renc),
    Fr(~response_random), Fr(~response) ]
  --[ DeviceCandidateAdopted(client_id, device_id, request_id,
                            old_psk, new_psk, renc, rctx, ctx,
                            <'none', 'none'>),
      DeviceRequestAccepted(client_id, device_id, request_id,
                            new_psk, 'candidate', renc,
                            enc, c0, ctx, request) ]->
  [ DeviceBinding(client_id, device_id, skD, new_psk),
    CheckedResponseWire(client_id, device_id, request_id,
                        new_psk, ctx, 'candidate', renc,
                        ~response_random, response_ct) ]

rule DeviceAcceptsUnderCurrentPSK:
  let ctx = psk_context(request_seed, current_psk, client_id,
                        hpke_info('agentknock-v1', device_id, request_id))
      enc = aenc(request_seed, pk(skD))
      c0 = senc(request, record_key(ctx, 'record_0'))
      secret = exporter(ctx, 'agentknock-v1 response')
      key = response_kdf(secret, enc, ~response_random, 'key')
      nonce = response_kdf(secret, enc, ~response_random, 'nonce')
      response_ct = senc(~response, <key, nonce>)
  in
  [ DeviceBinding(client_id, device_id, skD, current_psk),
    PendingRequestWire(client_id, device_id, request_id,
                       enc, c0, rotation_field),
    Fr(~response_random), Fr(~response) ]
  --[ DeviceCurrentRequestAccepted(client_id, device_id, request_id,
                                  current_psk, rotation_field, ctx),
      DeviceRequestAccepted(client_id, device_id, request_id,
                            current_psk, 'current', rotation_field,
                            enc, c0, ctx, request) ]->
  [ DeviceBinding(client_id, device_id, skD, current_psk),
    CheckedResponseWire(client_id, device_id, request_id,
                        current_psk, ctx, 'current', rotation_field,
                        ~response_random, response_ct) ]

rule ClientAcceptsResponseAndConfirmsRotation:
  let secret = exporter(ctx, 'agentknock-v1 response')
      key = response_kdf(secret, enc, response_random, 'key')
      nonce = response_kdf(secret, enc, response_random, 'nonce')
  in
  [ ClientBinding(client_id, device_id, pkD,
                  new_psk, 'pending', renc),
    ClientWaitResponse(client_id, device_id, request_id,
                       new_psk, renc, enc, ctx),
    CheckedResponseWire(client_id, device_id, request_id,
                        new_psk, ctx, response_class,
                        device_rotation_field, response_random,
                        senc(response, <key, nonce>)) ]
  --[ ClientRotationConfirmed(client_id, device_id,
                              request_id, new_psk, renc) ]->
  [ ClientBinding(client_id, device_id, pkD,
                  new_psk, 'none', 'none') ]

restriction UniqueDeviceRequestSlot:
  "All client_id device_id request_id psk1 class1 rotation1 enc1 c01 ctx1 x1
       psk2 class2 rotation2 enc2 c02 ctx2 x2 #i #j.
       DeviceRequestAccepted(client_id, device_id, request_id,
                             psk1, class1, rotation1,
                             enc1, c01, ctx1, x1)@i
     & DeviceRequestAccepted(client_id, device_id, request_id,
                             psk2, class2, rotation2,
                             enc2, c02, ctx2, x2)@j
     ==> #i = #j"

lemma R06_confirmation_matches_device_successor:
  "All client_id device_id rid new renc #i.
       ClientRotationConfirmed(client_id, device_id,
                               rid, new, renc)@i
     ==> (Ex old rctx ctx prev #j.
            DeviceCandidateAdopted(client_id, device_id, rid,
                                   old, new, renc,
                                   rctx, ctx, prev)@j & #j < #i)
       | (Ex ctx ignored_rotation #j.
            DeviceCurrentRequestAccepted(client_id, device_id, rid,
                                         new, ignored_rotation, ctx)@j
          & #j < #i)"

lemma R06_only_matching_pending_encapsulation_is_cleared:
  "All client_id device_id rid new renc #i.
       ClientRotationConfirmed(client_id, device_id,
                               rid, new, renc)@i
     ==> (Ex enc c0 ctx request #j.
            ClientPendingRequestSent(client_id, device_id, rid,
                                     new, renc, enc, c0, ctx, request)@j
          & #j < #i)"

end
