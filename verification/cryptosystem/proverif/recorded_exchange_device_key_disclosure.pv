(* Run with: proverif -lib recorded_exchange.pvl recorded_exchange_device_key_disclosure.pv
   Sensitivity control: skD reconstructs the recorded base PSK and every
   ordinary context, exposing which chosen plaintext tuple was recorded. *)
process
  new release: channel;
  (RecordedBindings(release) |
   !in(release, (binding_psk: psk, skd: device_secret_key, ctx: hpke_context));
    out(network, skd))
