(* Run with: proverif -lib recorded_exchange.pvl recorded_exchange_context_disclosure.pv
   Sensitivity control: the live context directly opens both HPKE records
   and derives the response key/nonce, exposing the chosen plaintext world. *)
process
  new release: channel;
  (RecordedBindings(release) |
   !in(release, (binding_psk: psk, skd: device_secret_key, ctx: hpke_context));
    out(network, ctx))
