#!/bin/sh

set -eu

repository_root=$(unset CDPATH; cd -- "$(dirname "$0")/.." && pwd)
dist_dir=${1:-$repository_root/target/npm}
test_dir=$(mktemp -d)

cleanup() {
	rm -rf -- "$test_dir"
}
trap cleanup EXIT HUP INT TERM

check_sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum --check "$1"
	else
		shasum -a 256 --check "$1"
	fi
}

version=$(awk '
	/^\[package\]$/ { package = 1; next }
	/^\[/ { package = 0 }
	package && /^version = "/ {
		sub(/^version = "/, "")
		sub(/"$/, "")
		print
		exit
	}
' "$repository_root/Cargo.toml")
[ -n "$version" ] || {
	printf 'could not read the Agentknock version from Cargo.toml\n' >&2
	exit 1
}
package=agentknock-$version.tgz

(
	cd "$dist_dir"
	check_sha256 "$package.sha256"
)

npm install --ignore-scripts --no-audit --no-fund --prefix "$test_dir" \
	"$dist_dir/$package"

for target in \
	x86_64-unknown-linux-musl \
	aarch64-unknown-linux-musl \
	aarch64-apple-darwin; do
	test -x "$test_dir/node_modules/agentknock/bin/agentknock-$target"
done

actual=$("$test_dir/node_modules/.bin/agentknock" --version)
expected="agentknock $version"
[ "$actual" = "$expected" ] || {
	printf 'expected "%s", got "%s"\n' "$expected" "$actual" >&2
	exit 1
}
