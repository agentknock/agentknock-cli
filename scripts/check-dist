#!/bin/sh

set -eu

target=${1:?target is required}
dist_dir=${2:?distribution directory is required}
archive="agentknock-$target.tar.gz"
unpack_dir=$(mktemp -d)

cleanup() {
	rm -rf -- "$unpack_dir"
}
trap cleanup EXIT HUP INT TERM

check_sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum --check "$1"
	else
		shasum -a 256 --check "$1"
	fi
}

(
	cd "$dist_dir"
	check_sha256 "$archive.sha256"
)

tar --extract --gzip --file="$dist_dir/$archive" --directory="$unpack_dir"
"$unpack_dir/agentknock" --version
